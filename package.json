{
  "name": "eat-what",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && BASE_PATH=/eat-what/ vite build",
    "preview": "vite preview",
    "preview:pages": "BASE_PATH=/eat-what/ vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:codes": "wrangler secret put ACCESS_CODES --config worker/wrangler.toml"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "typescript": "5.9",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.138.0"
  }
}
